# ── Privy (required for passkey login) ──
# Get these from https://dashboard.privy.io — create an app, enable passkey
# login, Platform = Web. Privy's SDK hard-requires the app ID to be exactly
# 25 characters (it throws a client-side render error otherwise) — real IDs
# are always this length, so this only bites you with a hand-typed
# placeholder. Login itself will still fail until the ID is real, but the
# rest of the app renders fine either way.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# ── Web Push (optional — Serwist push-notification starter code) ──
WEB_PUSH_EMAIL=
WEB_PUSH_PRIVATE_KEY=
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=

# ── Kuru (not yet wired — build order step 3) ──
# Testnet market address(es) for the 1-2 markets Kage reads/writes against.
# See docs.kuru.io quickstart-sdk / orderbook-sdk for the exact shape.
NEXT_PUBLIC_KURU_MARKET_MON_USDC=
NEXT_PUBLIC_KURU_MARKET_WMON_USDC=

# ── Envio HyperIndex (not yet wired — build order step 4) ──
# GraphQL endpoint of the deployed indexer for Kuru order-placed / filled /
# cancelled events on Monad Testnet (chain id 10143).
NEXT_PUBLIC_ENVIO_GRAPHQL_URL=

# ── Nansen Smart Money API (not yet wired — build order step 10) ──
# Server-side only — never expose with NEXT_PUBLIC_. Falls back to the
# Envio-computed "Top PnL (beta)" ranking when this is unset.
NANSEN_API_KEY=

# ── Website (usekage.xyz) ──
# Link to the Android preview APK. Unset → the download button reads
# "Android build coming soon".
NEXT_PUBLIC_APK_URL=
