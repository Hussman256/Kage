# ── Privy (required for passkey login) ──
# Get these from https://dashboard.privy.io — create an app, enable passkey
# login, Platform = Web. Privy's SDK hard-requires the app ID to be exactly
# 25 characters (it throws a client-side render error otherwise) — real IDs
# are always this length, so this only bites you with a hand-typed
# placeholder. Login itself will still fail until the ID is real, but the
# rest of the app renders fine either way.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# ── Web Push (optional — Serwist push-notification starter code) ──
WEB_PUSH_EMAIL=
WEB_PUSH_PRIVATE_KEY=
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=

# ── Nansen Smart Money API ──
# Server-side only — never expose with NEXT_PUBLIC_. Served to the app by
# /api/smart-money (cached 12h). Unset → the app stays "Top PnL (beta)".
NANSEN_API_KEY=

# ── Website (usekage.xyz) ──
# Link to the Android preview APK. Unset → the download button reads
# "Android build coming soon".
NEXT_PUBLIC_APK_URL=
