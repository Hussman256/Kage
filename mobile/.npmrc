# @privy-io/expo lists `permissionless` (smart wallets, unused here) as an
# optional peer, which in turn wants ox@^0.8 while viem pins ox@0.14. npm's
# strict peer resolution rejects that unused chain, so resolve peers loosely.
# Applies locally and on EAS Build. Privy's required peers are installed
# explicitly in package.json.
legacy-peer-deps=true
