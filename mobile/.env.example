# Copy to .env.local (gitignored). EXPO_PUBLIC_* values are bundled into the
# app, so only put public identifiers here — never secrets.

# Privy dashboard → your app → App ID
EXPO_PUBLIC_PRIVY_APP_ID=
# Privy dashboard → Configuration → App settings → Clients → your Android app client
EXPO_PUBLIC_PRIVY_CLIENT_ID=
# Origin that serves /.well-known/assetlinks.json for passkeys, e.g. https://usekage.xyz
EXPO_PUBLIC_PASSKEY_RELYING_PARTY=

# Optional: a dedicated Monad mainnet RPC (defaults to the public one)
EXPO_PUBLIC_MONAD_RPC_URL=

# Envio indexer GraphQL endpoint (Envio Cloud → your indexer → GraphQL URL).
# Unset: the leaderboard falls back to the last hour over RPC, without 24H/7D.
EXPO_PUBLIC_INDEXER_URL=

# Kage's site (serves /api/smart-money with Nansen labels; the Nansen key stays
# on the server). Local: http://<PC LAN IP>:3000 with `npm run dev` at the repo root.
EXPO_PUBLIC_KAGE_API_URL=
